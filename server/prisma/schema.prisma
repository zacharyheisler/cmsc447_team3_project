// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId          Int           @id @default(autoincrement()) @db.Integer @map("user_id")
  email           String        @unique @db.VarChar(120)
  phoneNumber     String        @unique @db.VarChar(20) @map("phone_number")
  password        String        @db.VarChar(255)
  accountCreated  DateTime      @default(now()) @db.Timestamp(0) @map("account_created")

  // CompanyId Foreign key
  companyId       Int           @map("company_id")
  company         Company       @relation(fields: [companyId], references: [companyId])
}

model Company {
  companyId       Int           @id @default(autoincrement()) @db.Integer @map("company_id")
  name            String        @db.VarChar(120)
  dateJoined      DateTime      @default(now()) @db.Timestamp(0) @map("date_joined")

  // Map one-to-many relationship between Company-User
  users           User[]       
}

model TicketMessage {
  messageId         Int         @id @default(autoincrement()) @db.Integer @map("message_id")
  content           String      @db.VarChar(1000)
  sent_at           DateTime    @default(now()) @db.Timestamp(0) @map("sent_at")
  isAiGenerated     Boolean     @default(false) @map("is_ai_generated")
  
  // TicketId Foreign key
  ticketId          Int         @map("ticket_id")
  ticket            Ticket      @relation(fields: [ticketId], references: [ticketId])

  // Sender Foreign key, can be a user or agent sending a message
  userId            Int?        @map("user_id")
  agentId           Int?        @map("agent_id")
  user              User?       @relation(fields: [userId], references: [userId])
  agent             Agent?      @relation(fields: [agentId], references: [agentId])
}